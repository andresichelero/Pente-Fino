---
import "../styles/global.css";

interface Props {
  title: string;
  lead?: string;
  active?: string;
}

const { title, lead, active } = Astro.props;

const nav = [
  { href: "/", id: "overview", label: "Visão geral" },
  { href: "/programs", id: "programs", label: "Programas e escopo" },
  { href: "/assets", id: "assets", label: "Ativos" },
  { href: "/scans", id: "scans", label: "Scans e recon" },
  { href: "/findings", id: "findings", label: "Achados" },
  { href: "/templates", id: "templates", label: "Templates" },
  { href: "/telemetry", id: "telemetry", label: "Rede" },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · PenteFino</title>
    <meta name="description" content="Plano de controle de governança e descoberta de vulnerabilidades PenteFino." />
    <script is:inline>
      // Respect a saved theme choice before paint to avoid a flash.
      try {
        const t = localStorage.getItem("pf-theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">PenteFino</a>
        <nav aria-label="Seções">
          <ul class="nav">
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={active === n.id ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button id="theme-toggle" class="conn" type="button" aria-label="Alternar tema claro/escuro">
          Tema
        </button>
      </div>
    </header>

    <main>
      <div class="page-head">
        <h1>{title}</h1>
        {lead && <p>{lead}</p>}
      </div>
      <slot />
    </main>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = matchMedia("(prefers-color-scheme: dark)").matches;
        const current = root.dataset.theme || (dark ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("pf-theme", next);
        } catch (e) {}
      });
    </script>
  </body>
</html>
