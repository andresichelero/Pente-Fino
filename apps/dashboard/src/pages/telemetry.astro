---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveProxyStreamer from "../components/islands/LiveProxyStreamer";
import { API_BASE_URL, WS_BASE_URL, fetchTelemetrySummary } from "../lib/api";

const summary = await fetchTelemetrySummary();
---

<BaseLayout
  title="Telemetria"
  activeNav="telemetry"
>
  <!-- Interactive Island: LiveProxyStreamer (with Sparklines & separated telemetry_tick vs http_egress) -->
  <section>
    <LiveProxyStreamer
      client:load
      wsBaseUrl={WS_BASE_URL}
      apiBaseUrl={API_BASE_URL}
      initialSummary={summary}
    />
  </section>
</BaseLayout>
