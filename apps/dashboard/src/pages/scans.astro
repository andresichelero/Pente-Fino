---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveScanRunner from "../components/islands/LiveScanRunner";
import {
  API_BASE_URL,
  WS_BASE_URL,
  fetchPrograms,
  fetchAssets,
  fetchScanHistory,
} from "../lib/api";

const programs = await fetchPrograms();
const querySlug = Astro.url.searchParams.get("program");
const activeSlug =
  querySlug && programs.some((p) => p.slug === querySlug)
    ? querySlug
    : programs[0]?.slug || "";

const [assets, scanHistory] = await Promise.all([
  fetchAssets(activeSlug),
  fetchScanHistory(),
]);

const cdnProviders = ["cloudflare", "akamai", "fastly", "incapsula", "sucuri", "cloudfront"];
---

<BaseLayout
  title="Detection Planner & Execução de Scans"
  subtitle="Poda Inteligente de Templates por CDN/WAF, Isolamento em Containers Efêmeros & Streaming WebSocket"
  activeNav="scans"
>
  <!-- Edge CDN/WAF Tag Pruning & Ephemeral Container Architecture Header -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <!-- Edge CDN/WAF Pruning Card -->
    <div class="bg-bg-panel border border-border-grid rounded-xl p-5 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-amber-500/15 text-accent-amber border border-amber-500/30 font-semibold">
          DETECTION PLANNER • CDN PRUNING
        </span>
        <span class="text-xs font-mono text-slate-400">Anti-False-Positive & Rate Saver</span>
      </div>
      <h2 class="text-sm font-bold text-white font-mono">
        Poda Automática de Checks de Infraestrutura Origin Atrás de Edge CDN/WAF
      </h2>
      <p class="text-xs text-slate-300 leading-relaxed">
        Quando o probe <code class="text-cyan-300">httpx</code> identifica que um ativo está protegido por borda
        CDN/WAF, o <code class="text-emerald-300">DetectionPlanner</code> poda automaticamente templates de
        infraestrutura/rede de origem (portas TCP baixas, banners de roteadores, checks de IP direto) e preserva
        apenas templates relevantes ao stack de aplicação HTTP detectado.
      </p>
      <div class="flex items-center gap-2 flex-wrap pt-1">
        {
          cdnProviders.map((cdn) => (
            <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-amber-300">
              edge:{cdn}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Ephemeral Container Isolation Card -->
    <div class="bg-bg-panel border border-border-grid rounded-xl p-5 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-mono uppercase px-2 py-0.5 rounded bg-emerald-500/15 text-accent-emerald border border-emerald-500/30 font-semibold">
          DOCKER RUNNER • HARDENED SANDBOX
        </span>
        <span class="text-xs font-mono text-slate-400">Zero Direct Egress</span>
      </div>
      <h2 class="text-sm font-bold text-white font-mono">
        Containers Efêmeros sem Capacidades Linux e Roteamento Forçado pelo Proxy
      </h2>
      <p class="text-xs text-slate-300 leading-relaxed">
        Todos os adaptadores (<code class="text-cyan-300">subfinder</code>, <code class="text-cyan-300">dnsx</code>,{" "}
        <code class="text-cyan-300">httpx</code>, <code class="text-cyan-300">nuclei</code>) executam com{" "}
        <code class="text-emerald-300">--cap-drop=ALL</code>, <code class="text-emerald-300">--security-opt=no-new-privileges</code>,{" "}
        rootfs somente-leitura, <code class="text-emerald-300">pids_limit=256</code> e{" "}
        <code class="text-amber-300">HTTP_PROXY=http://pentefino_proxy:8080</code>.
      </p>
      <div class="flex items-center gap-2 flex-wrap pt-1 font-mono text-[10px]">
        <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-emerald-300">
          --cap-drop=ALL
        </span>
        <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-emerald-300">
          read_only=true
        </span>
        <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-cyan-300">
          -disable-update-check
        </span>
        <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-amber-300">
          -interactsh-disable
        </span>
      </div>
    </div>
  </section>

  <!-- Interactive Island: LiveScanRunner -->
  <section>
    <LiveScanRunner
      client:load
      programs={programs}
      initialSlug={activeSlug}
      initialAssets={assets}
      scanHistory={scanHistory}
      apiBaseUrl={API_BASE_URL}
      wsBaseUrl={WS_BASE_URL}
    />
  </section>
</BaseLayout>
