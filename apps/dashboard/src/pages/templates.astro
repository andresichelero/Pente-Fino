---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchTemplates, fetchTemplateStats } from "../lib/api";

const url = Astro.url;
const impactClass = url.searchParams.get("impact_class") || "";
const severity = url.searchParams.get("severity") || "";
const tech = url.searchParams.get("tech") || "";
const protocol = url.searchParams.get("protocol") || "";
const q = url.searchParams.get("q") || "";
const page = Math.max(1, parseInt(url.searchParams.get("page") || "1", 10) || 1);
const pageSize = 25;

const [stats, pageData] = await Promise.all([
  fetchTemplateStats(),
  fetchTemplates({
    impact_class: impactClass,
    severity,
    tech,
    protocol,
    q,
    page,
    page_size: pageSize,
  }),
]);

function buildPageUrl(targetPage: number): string {
  const params = new URLSearchParams(url.searchParams);
  params.set("page", String(targetPage));
  return `/templates?${params.toString()}`;
}

function impactColor(ic: string): string {
  switch (ic) {
    case "safe_read_only":
    case "passive":
      return "text-[#34d399]";
    case "active_reviewed":
      return "text-[#22d3ee]";
    case "stateful":
      return "text-[#fbbf24]";
    case "intrusive":
      return "text-[#f87171]";
    default:
      return "text-[#a78bfa]";
  }
}

function severityColor(sev?: string | null): string {
  switch ((sev || "").toLowerCase()) {
    case "critical":
      return "text-[#f87171] font-bold";
    case "high":
      return "text-orange-400 font-semibold";
    case "medium":
      return "text-[#fbbf24]";
    case "low":
      return "text-[#22d3ee]";
    default:
      return "text-[#8b98a9]";
  }
}
---

<BaseLayout
  title="Templates Nuclei"
  activeNav="templates"
>
  <!-- Compact Segmented Impact Class Bar -->
  <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
    <a
      href="/templates"
      class:list={[
        "card card-pad transition num",
        !impactClass ? "border-[#34d399]/60 bg-[#11161f]" : "hover:border-[#263042]",
      ]}
    >
      <div class="card-title">ALL TEMPLATES</div>
      <div class="kpi mt-1">{(stats.total ?? 0).toLocaleString("en-US")}</div>
    </a>

    {
      ["safe_read_only", "active_reviewed", "stateful", "intrusive", "lab_only"].map((ic) => {
        const count = stats.by_impact_class?.[ic] ?? 0;
        const active = impactClass === ic;
        return (
          <a
            href={`/templates?impact_class=${ic}`}
            class:list={[
              "card card-pad transition num",
              active ? "border-[#34d399]/60 bg-[#11161f]" : "hover:border-[#263042]",
            ]}
          >
            <div class="card-title truncate">{ic}</div>
            <div class:list={["kpi mt-1", impactColor(ic)]}>{count.toLocaleString("en-US")}</div>
          </a>
        );
      })
    }
  </section>

  <!-- Compact SSR Filter Form -->
  <section class="card card-pad">
    <form method="GET" action="/templates" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
      <div class="lg:col-span-2">
        <label class="field-label">Search (ID, Name, CVE, Tag)</label>
        <input
          type="text"
          name="q"
          value={q}
          placeholder="CVE-2024, log4j, exposed-panels..."
          class="input"
        />
      </div>

      <div>
        <label class="field-label">Impact Class</label>
        <select name="impact_class" class="input">
          <option value="">All Classes</option>
          <option value="safe_read_only" selected={impactClass === "safe_read_only"}>
            safe_read_only
          </option>
          <option value="active_reviewed" selected={impactClass === "active_reviewed"}>
            active_reviewed
          </option>
          <option value="stateful" selected={impactClass === "stateful"}>
            stateful
          </option>
          <option value="intrusive" selected={impactClass === "intrusive"}>
            intrusive
          </option>
          <option value="lab_only" selected={impactClass === "lab_only"}>
            lab_only
          </option>
        </select>
      </div>

      <div>
        <label class="field-label">Severity</label>
        <select name="severity" class="input">
          <option value="">All</option>
          <option value="critical" selected={severity === "critical"}>Critical</option>
          <option value="high" selected={severity === "high"}>High</option>
          <option value="medium" selected={severity === "medium"}>Medium</option>
          <option value="low" selected={severity === "low"}>Low</option>
          <option value="info" selected={severity === "info"}>Info</option>
        </select>
      </div>

      <div>
        <label class="field-label">Technology / Stack</label>
        <input
          type="text"
          name="tech"
          value={tech}
          placeholder="nginx, apache, wordpress..."
          class="input"
        />
      </div>

      <div class="flex items-center gap-2">
        <button type="submit" class="btn btn-primary flex-1">Filter</button>
        <a href="/templates" class="btn">Reset</a>
      </div>
    </form>
  </section>

  <!-- SESSION BENCHMARKS Style Templates Table with Expandable YAML Drawer -->
  <section class="card overflow-hidden">
    <div class="px-4 py-3 border-b border-[#1b2230] flex flex-wrap items-center justify-between gap-3 num text-xs">
      <div class="text-[#8b98a9]">
        Page <span class="text-white font-semibold">{pageData.page}</span> of{" "}
        <span class="text-white font-semibold">{pageData.total_pages}</span> · Filtered:{" "}
        <span class="text-[#34d399] font-semibold">{pageData.total.toLocaleString("en-US")}</span> templates
      </div>

      <div class="flex items-center gap-2">
        {
          pageData.page > 1 && (
            <a href={buildPageUrl(pageData.page - 1)} class="btn text-xs">
              ← Prev
            </a>
          )
        }
        {
          pageData.page < pageData.total_pages && (
            <a href={buildPageUrl(pageData.page + 1)} class="btn text-xs">
              Next →
            </a>
          )
        }
      </div>
    </div>

    <!-- Column Header Row -->
    <div class="grid grid-cols-12 gap-3 px-4 py-2 border-b border-[#1b2230] bg-[#070a0f]/50 font-mono text-[11px] uppercase text-[#738196]">
      <div class="col-span-4">Template ID / Name</div>
      <div class="col-span-2">Impact Class</div>
      <div class="col-span-1">Severity</div>
      <div class="col-span-2">Protocol / CVE</div>
      <div class="col-span-2">Tech Stack</div>
      <div class="col-span-1 text-right">YAML</div>
    </div>

    <div class="divide-y divide-[#1b2230] num text-xs">
      {
        pageData.items.length === 0 ? (
          <div class="p-8 text-center text-[#8b98a9] font-mono text-xs">
            Nenhum template encontrado para os filtros selecionados.
          </div>
        ) : (
          pageData.items.map((tpl) => (
            <details class="group hover:bg-[#11161f]/60 transition">
              <summary class="list-none grid grid-cols-12 gap-3 px-4 py-2.5 items-center">
                <div class="col-span-4 min-w-0">
                  <div class="font-semibold text-white group-open:text-[#34d399] truncate">{tpl.id}</div>
                  <div class="text-[11px] text-[#8b98a9] truncate font-sans">{tpl.name}</div>
                </div>

                <div class:list={["col-span-2 font-semibold truncate", impactColor(tpl.impact_class)]}>
                  {tpl.impact_class}
                </div>

                <div class:list={["col-span-1 uppercase", severityColor(tpl.severity)]}>
                  {tpl.severity || "info"}
                </div>

                <div class="col-span-2 text-[#8b98a9] truncate">
                  <span>{tpl.protocol}</span>
                  {tpl.http_methods?.length ? <span class="text-[#738196]"> ({tpl.http_methods.join(",")})</span> : null}
                  {tpl.cve_id ? <span class="ml-1.5 text-[#f87171]">{tpl.cve_id}</span> : null}
                </div>

                <div class="col-span-2 flex items-center gap-1 flex-wrap">
                  {(tpl.technologies || []).slice(0, 2).map((t) => (
                    <a
                      href={`/templates?tech=${encodeURIComponent(t)}`}
                      class="pill text-[#22d3ee] hover:border-[#22d3ee]/50"
                    >
                      {t}
                    </a>
                  ))}
                  {(!tpl.technologies || tpl.technologies.length === 0) && (
                    <span class="text-[#738196]">—</span>
                  )}
                </div>

                <div class="col-span-1 text-right text-[#34d399] text-[11px]">
                  [YAML ▾]
                </div>
              </summary>

              <div class="px-4 pb-4 pt-2 bg-[#070a0f]/70 border-t border-[#1b2230] space-y-2.5">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 p-2.5 rounded-lg bg-[#0d1117] border border-[#1b2230] text-[11px]">
                  <div>
                    <span class="text-[#738196] block text-[10px]">SHA-256 BUNDLE HASH</span>
                    <span class="text-[#34d399] break-all">{tpl.bundle_hash}</span>
                  </div>
                  <div>
                    <span class="text-[#738196] block text-[10px]">UPSTREAM REVISION</span>
                    <span class="text-white">{tpl.upstream_revision}</span>
                  </div>
                  <div>
                    <span class="text-[#738196] block text-[10px]">TAGS</span>
                    <span class="text-[#8b98a9]">{(tpl.tags || []).join(", ") || "—"}</span>
                  </div>
                </div>

                {tpl.raw_yaml ? (
                  <pre class="p-3 rounded-lg bg-[#0d1117] border border-[#1b2230] text-[#e6edf3] overflow-x-auto max-h-72 text-[11px] leading-relaxed"><code>{tpl.raw_yaml}</code></pre>
                ) : (
                  <div class="text-[11px] text-[#738196]">
                    YAML source available on detail query `/api/v1/templates/{tpl.id}`.
                  </div>
                )}
              </div>
            </details>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>
