---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScopeLiveTester from "../components/islands/ScopeLiveTester";
import { API_BASE_URL, fetchPrograms } from "../lib/api";

const programs = await fetchPrograms();
const querySlug = Astro.url.searchParams.get("program");
const activeSlug =
  querySlug && programs.some((p) => p.slug === querySlug)
    ? querySlug
    : programs[0]?.slug || "";
---

<BaseLayout
  title="Programas & Escopo"
  activeNav="programs"
>
  <!-- Interactive Island: ScopeLiveTester -->
  <section>
    <ScopeLiveTester
      client:load
      initialPrograms={programs}
      initialSlug={activeSlug}
      apiBaseUrl={API_BASE_URL}
    />
  </section>
</BaseLayout>
