---
import BaseLayout from "../layouts/BaseLayout.astro";
import AssetRelationshipGraph from "../components/islands/AssetRelationshipGraph";
import {
  API_BASE_URL,
  fetchPrograms,
  fetchAssets,
  fetchAssetGraph,
} from "../lib/api";

const programs = await fetchPrograms();
const querySlug = Astro.url.searchParams.get("program");
const activeSlug =
  querySlug && programs.some((p) => p.slug === querySlug)
    ? querySlug
    : programs[0]?.slug || "";

const [assets, graphData] = await Promise.all([
  fetchAssets(activeSlug),
  fetchAssetGraph(activeSlug),
]);

const countExplicit =
  assets.filter((a) => a.scope_state === "in_scope_explicit").length ||
  graphData.summary?.in_scope_explicit ||
  0;
const countDerived =
  assets.filter((a) => a.scope_state === "in_scope_derived").length ||
  graphData.summary?.in_scope_derived ||
  0;
const countCandidate =
  assets.filter((a) => a.scope_state === "candidate").length ||
  graphData.summary?.candidate ||
  0;
const countOut =
  assets.filter((a) => a.scope_state === "out_of_scope").length ||
  graphData.summary?.out_of_scope ||
  0;
const countObservationIps =
  graphData.nodes.filter((n: any) => (n.node_type || n.data?.type) === "observed_ip" || (n.node_type || n.data?.type) === "observation_ip").length ||
  graphData.summary?.observation_ips ||
  0;
const totalAssets = Math.max(1, countExplicit + countDerived + countCandidate + countOut);
---

<BaseLayout
  title="Ativos"
  activeNav="assets"
>
  {
    programs.length === 0 ? (
      <section class="card card-pad py-16 text-center space-y-4">
        <div class="w-12 h-12 mx-auto rounded-full bg-[#11161f] border border-[#1b2230] flex items-center justify-center text-[#738196]">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white">Nenhum programa cadastrado</h3>
          <p class="text-xs text-[#738196] mt-1 max-w-sm mx-auto">
            Cadastre um programa para visualizar o mapeamento de ativos e o grafo topológico.
          </p>
        </div>
        <div>
          <a href="/programs" class="btn btn-primary">
            + Cadastrar Programa
          </a>
        </div>
      </section>
    ) : (
      <>
        <!-- 4 Compact ScopeState KPI Cards with Capacity Bars -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
          <div class="card card-pad space-y-2">
            <div class="flex items-center justify-between">
              <span class="card-title">IN_SCOPE_EXPLICIT</span>
            </div>
            <div class="kpi text-[#34d399]">{countExplicit}</div>
            <div class="bar text-[#34d399]">
              <span style={`width: ${Math.max(4, Math.round((countExplicit / totalAssets) * 100))}%`}></span>
            </div>
          </div>

          <div class="card card-pad space-y-2">
            <div class="flex items-center justify-between">
              <span class="card-title">IN_SCOPE_DERIVED</span>
            </div>
            <div class="kpi text-[#22d3ee]">{countDerived}</div>
            <div class="bar text-[#22d3ee]">
              <span style={`width: ${Math.max(4, Math.round((countDerived / totalAssets) * 100))}%`}></span>
            </div>
          </div>

          <div class="card card-pad space-y-2">
            <div class="flex items-center justify-between">
              <span class="card-title">CANDIDATE</span>
            </div>
            <div class="kpi text-[#fbbf24]">{countCandidate}</div>
            <div class="bar text-[#fbbf24]">
              <span style={`width: ${Math.max(4, Math.round((countCandidate / totalAssets) * 100))}%`}></span>
            </div>
          </div>

          <div class="card card-pad space-y-2">
            <div class="flex items-center justify-between">
              <span class="card-title">OUT_OF_SCOPE</span>
            </div>
            <div class="kpi text-[#f87171]">{countOut}</div>
            <div class="bar text-[#f87171]">
              <span style={`width: ${Math.max(4, Math.round((countOut / totalAssets) * 100))}%`}></span>
            </div>
          </div>
        </section>

        <!-- Interactive Topological Graph Island -->
        <section>
          <AssetRelationshipGraph
            client:load
            programs={programs}
            initialSlug={activeSlug}
            initialGraph={graphData}
            initialAssets={assets}
            apiBaseUrl={API_BASE_URL}
          />
        </section>
      </>
    )
  }
</BaseLayout>
