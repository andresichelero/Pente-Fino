---
import BaseLayout from "../layouts/BaseLayout.astro";
import AssetRelationshipGraph from "../components/islands/AssetRelationshipGraph";
import {
  API_BASE_URL,
  fetchPrograms,
  fetchAssets,
  fetchAssetGraph,
} from "../lib/api";

const programs = await fetchPrograms();
const querySlug = Astro.url.searchParams.get("program");
const activeSlug =
  querySlug && programs.some((p) => p.slug === querySlug)
    ? querySlug
    : programs[0]?.slug || "";

const [assets, graphData] = await Promise.all([
  fetchAssets(activeSlug),
  fetchAssetGraph(activeSlug),
]);

const countExplicit =
  assets.filter((a) => a.scope_state === "in_scope_explicit").length ||
  graphData.summary?.in_scope_explicit ||
  0;
const countDerived =
  assets.filter((a) => a.scope_state === "in_scope_derived").length ||
  graphData.summary?.in_scope_derived ||
  0;
const countCandidate =
  assets.filter((a) => a.scope_state === "candidate").length ||
  graphData.summary?.candidate ||
  0;
const countOut =
  assets.filter((a) => a.scope_state === "out_of_scope").length ||
  graphData.summary?.out_of_scope ||
  0;
const countObservationIps =
  graphData.nodes.filter((n) => n.data?.type === "observation_ip").length ||
  graphData.summary?.observation_ips ||
  0;
---

<BaseLayout
  title="Ativos & Grafo Topológico de Superfície"
  subtitle="Descoberta Subfinder / DNSX / HTTPX • Visualização Cytoscape.js & Invariante Anti-Escopo de IPs"
  activeNav="assets"
>
  <!-- Critical IP Invariant Banner -->
  <section class="bg-cyan-950/20 border border-accent-cyan/40 rounded-xl p-5 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase rounded bg-accent-cyan/20 text-accent-cyan border border-accent-cyan/40">
          CRITICAL ARCHITECTURAL INVARIANT
        </span>
        <h2 class="text-sm font-bold text-white font-mono">
          Resolução DNS A/AAAA Nunca Promove IPs para Escopo Ativo
        </h2>
      </div>
      <p class="text-xs text-slate-300 leading-relaxed max-w-4xl">
        Quando um domínio em escopo (<code class="text-emerald-300">in_scope_explicit</code> ou{" "}
        <code class="text-cyan-300">in_scope_derived</code>) resolve para endereços IPv4/IPv6 de CDNs
        compartilhadas (Cloudflare, Akamai, Fastly, AWS CloudFront), o adaptador <code class="text-amber-300">dnsx</code>{" "}
        grava esses IPs exclusivamente como metadados JSON em <code class="text-cyan-300">Observation</code>. Nenhum
        registro <code class="text-white">Asset(asset_type='ip')</code> em escopo é criado a partir de resolução DNS,
        eliminando o risco de varrer infraestrutura multi-tenant de terceiros.
      </p>
    </div>

    <div class="flex items-center gap-3 shrink-0 font-mono text-xs">
      <div class="px-3 py-2 rounded-lg bg-slate-950/80 border border-slate-800 text-center">
        <div class="text-[10px] text-slate-400">OBSERVATION IPs</div>
        <div class="text-base font-bold text-accent-cyan">{countObservationIps}</div>
      </div>
      <div class="px-3 py-2 rounded-lg bg-slate-950/80 border border-slate-800 text-center">
        <div class="text-[10px] text-slate-400">PROMOTED TO ASSET</div>
        <div class="text-base font-bold text-accent-emerald">0 (BLOCKED)</div>
      </div>
    </div>
  </section>

  <!-- Summary Counters by ScopeState -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-bg-panel border border-border-grid rounded-xl p-4">
      <div class="text-[11px] font-mono text-slate-400 uppercase">IN_SCOPE_EXPLICIT</div>
      <div class="text-2xl font-mono font-bold text-accent-emerald mt-1">{countExplicit}</div>
      <div class="text-[11px] text-slate-500 mt-0.5">Domínios / hosts explicitamente autorizados</div>
    </div>

    <div class="bg-bg-panel border border-border-grid rounded-xl p-4">
      <div class="text-[11px] font-mono text-slate-400 uppercase">IN_SCOPE_DERIVED</div>
      <div class="text-2xl font-mono font-bold text-accent-cyan mt-1">{countDerived}</div>
      <div class="text-[11px] text-slate-500 mt-0.5">Subdomínios derivados de regra wildcard</div>
    </div>

    <div class="bg-bg-panel border border-border-grid rounded-xl p-4">
      <div class="text-[11px] font-mono text-slate-400 uppercase">CANDIDATE (DISCOVER_ONLY)</div>
      <div class="text-2xl font-mono font-bold text-accent-amber mt-1">{countCandidate}</div>
      <div class="text-[11px] text-slate-500 mt-0.5">Apenas enumeração passiva sem scan ativo</div>
    </div>

    <div class="bg-bg-panel border border-border-grid rounded-xl p-4">
      <div class="text-[11px] font-mono text-slate-400 uppercase">OUT_OF_SCOPE</div>
      <div class="text-2xl font-mono font-bold text-accent-crimson mt-1">{countOut}</div>
      <div class="text-[11px] text-slate-500 mt-0.5">Bloqueados pelo motor Fail-Closed</div>
    </div>
  </section>

  <!-- Interactive Cytoscape.js Island -->
  <section>
    <AssetRelationshipGraph
      client:load
      programs={programs}
      initialSlug={activeSlug}
      initialGraph={graphData}
      initialAssets={assets}
      apiBaseUrl={API_BASE_URL}
    />
  </section>
</BaseLayout>
