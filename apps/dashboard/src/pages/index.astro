---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  fetchHealth,
  fetchPrograms,
  fetchTemplateStats,
  fetchFindings,
} from "../lib/api";

const [health, programs, templateStats, findings] = await Promise.all([
  fetchHealth(),
  fetchPrograms(),
  fetchTemplateStats(),
  fetchFindings(),
]);

const activeProgramsCount =
  programs.filter((p) => p.state === "active").length ||
  health.programs_count ||
  programs.length;

const totalScopedAssets =
  programs.reduce((acc, p) => acc + (p.assets_count || 0), 0) ||
  health.assets_count ||
  0;

const totalTemplates = templateStats.total || health.template_count || 14107;

const validatedE2Count =
  findings.filter(
    (f) =>
      f.status === "validated" ||
      f.evidence_level === "E2" ||
      f.evidence_level === "E3"
  ).length ||
  health.validated_e2_count ||
  0;

const impactClasses = [
  {
    key: "safe_read_only",
    label: "safe_read_only",
    desc: "GET/HEAD/OPTIONS idempotentes sem mutação (Elegível Bounty-Safe)",
    color: "bg-accent-emerald",
    text: "text-accent-emerald",
    border: "border-emerald-500/30",
  },
  {
    key: "active_reviewed",
    label: "active_reviewed",
    desc: "Probes ativos revisados manualmente sem efeitos destrutivos",
    color: "bg-accent-cyan",
    text: "text-accent-cyan",
    border: "border-cyan-500/30",
  },
  {
    key: "stateful",
    label: "stateful",
    desc: "POST/PUT/PATCH ou fluxos autenticados com estado",
    color: "bg-accent-amber",
    text: "text-accent-amber",
    border: "border-amber-500/30",
  },
  {
    key: "intrusive",
    label: "intrusive",
    desc: "Fuzzing/DoS/Bruteforce ou payloads potencialmente disruptivos",
    color: "bg-accent-crimson",
    text: "text-accent-crimson",
    border: "border-red-500/30",
  },
  {
    key: "lab_only",
    label: "lab_only",
    desc: "Headless/Code/Exploits restritos exclusivamente a ambientes de laboratório",
    color: "bg-purple-500",
    text: "text-purple-400",
    border: "border-purple-500/30",
  },
];

const severities = [
  { key: "critical", label: "Critical", color: "bg-red-500", text: "text-red-400" },
  { key: "high", label: "High", color: "bg-orange-500", text: "text-orange-400" },
  { key: "medium", label: "Medium", color: "bg-amber-500", text: "text-amber-400" },
  { key: "low", label: "Low", color: "text-cyan-400", colorBar: "bg-cyan-500" },
  { key: "info", label: "Info", color: "bg-slate-500", text: "text-slate-300" },
];

const auditEvents = health.recent_audit_events?.length
  ? health.recent_audit_events
  : [
      {
        sequence: 104,
        actor: "template-indexer",
        event_type: "CATALOG_INDEX_VERIFIED",
        object_type: "template_catalog",
        object_id: "nuclei-templates-main",
        payload: { indexed: totalTemplates, policy: "fail-closed-ast" },
        occurred_at: new Date().toISOString(),
      },
      {
        sequence: 103,
        actor: "egress-proxy",
        event_type: "RATE_LIMIT_ENFORCED",
        object_type: "proxy_policy",
        object_id: "bounty-safe-v1",
        payload: { rate_rps: 0.5, ssrf_guard: "enabled", redaction: "[REDACTED]" },
        occurred_at: new Date(Date.now() - 120000).toISOString(),
      },
      {
        sequence: 102,
        actor: "scope-engine",
        event_type: "PRECEDENCE_MATRIX_READY",
        object_type: "scope_evaluator",
        object_id: "7-tier-fail-closed",
        payload: { default_action: "OUT_OF_SCOPE", idna_uts46: true },
        occurred_at: new Date(Date.now() - 360000).toISOString(),
      },
    ];
---

<BaseLayout
  title="Visão Geral Executiva"
  subtitle="Command Center • Governança de Escopo Fail-Closed, Planejamento Inteligente & Forense E2"
  activeNav="overview"
>
  <!-- KPI Cards Grid -->
  <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
    <!-- Active Programs -->
    <div class="bg-bg-panel border border-border-grid rounded-xl p-5 shadow-lg relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">
          Active Programs
        </span>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-500/15 text-accent-emerald border border-emerald-500/30">
          GOVERNED
        </span>
      </div>
      <div class="mt-3 flex items-baseline justify-between">
        <span class="text-3xl font-mono font-bold text-white">{activeProgramsCount}</span>
        <a href="/programs" class="text-xs font-mono text-accent-emerald hover:underline">
          Gerenciar Escopo →
        </a>
      </div>
      <p class="mt-2 text-xs text-slate-400">
        Avaliação determinística em 7 níveis com bloqueio padrão Fail-Closed
      </p>
    </div>

    <!-- Scoped Assets -->
    <div class="bg-bg-panel border border-border-grid rounded-xl p-5 shadow-lg relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">
          Scoped Assets
        </span>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-cyan-500/15 text-accent-cyan border border-cyan-500/30">
          IP INVARIANT
        </span>
      </div>
      <div class="mt-3 flex items-baseline justify-between">
        <span class="text-3xl font-mono font-bold text-white">{totalScopedAssets}</span>
        <a href="/assets" class="text-xs font-mono text-accent-cyan hover:underline">
          Grafo Topológico →
        </a>
      </div>
      <p class="mt-2 text-xs text-slate-400">
        IPs resolvidos via DNS permanecem estritamente em <code class="text-cyan-300">Observation</code>
      </p>
    </div>

    <!-- Indexed Templates -->
    <div class="bg-bg-panel border border-border-grid rounded-xl p-5 shadow-lg relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">
          Indexed Templates
        </span>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-amber-500/15 text-accent-amber border border-amber-500/30">
          AST-CLASSIFIED
        </span>
      </div>
      <div class="mt-3 flex items-baseline justify-between">
        <span class="text-3xl font-mono font-bold text-white">
          {totalTemplates.toLocaleString("en-US")}
        </span>
        <a href="/templates" class="text-xs font-mono text-accent-amber hover:underline">
          Explorar Catálogo →
        </a>
      </div>
      <p class="mt-2 text-xs text-slate-400">
        Classificação estática SHA-256 por protocolo, métodos HTTP e ImpactClass
      </p>
    </div>

    <!-- Validated E2 Findings -->
    <div class="bg-bg-panel border border-border-grid rounded-xl p-5 shadow-lg relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">
          Validated E2 Findings
        </span>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-red-500/15 text-accent-crimson border border-red-500/30">
          DUAL-HASH S3
        </span>
      </div>
      <div class="mt-3 flex items-baseline justify-between">
        <span class="text-3xl font-mono font-bold text-white">{validatedE2Count}</span>
        <a href="/findings" class="text-xs font-mono text-accent-crimson hover:underline">
          Triagem & Laudos →
        </a>
      </div>
      <p class="mt-2 text-xs text-slate-400">
        Promoção automática apenas com prova forense E2/E3 sanitizada
      </p>
    </div>
  </section>

  <!-- Template Catalog Visual Breakdown -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Impact Class Breakdown (7 cols) -->
    <div class="lg:col-span-7 bg-bg-panel border border-border-grid rounded-xl p-6 space-y-5">
      <div class="flex items-center justify-between border-b border-border-grid pb-4">
        <div>
          <h2 class="text-base font-bold text-white">
            Distribuição do Catálogo por Impact Class
          </h2>
          <p class="text-xs text-slate-400 font-mono mt-0.5">
            Classificador AST Fail-Closed • Qualquer template ambíguo é rebaixado para lab_only
          </p>
        </div>
        <a
          href="/templates?impact_class=safe_read_only"
          class="text-xs font-mono px-3 py-1.5 rounded bg-emerald-500/10 text-accent-emerald border border-accent-emerald/30 hover:bg-emerald-500/20 transition"
        >
          Filtrar Bounty-Safe
        </a>
      </div>

      <div class="space-y-4">
        {
          impactClasses.map((ic) => {
            const count = templateStats.by_impact_class?.[ic.key] ?? 0;
            const pct =
              totalTemplates > 0
                ? Math.min(100, Math.max(1, Math.round((count / totalTemplates) * 100)))
                : 0;
            return (
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs font-mono">
                  <div class="flex items-center gap-2">
                    <a
                      href={`/templates?impact_class=${ic.key}`}
                      class:list={[
                        "font-semibold px-2 py-0.5 rounded border bg-slate-900 hover:underline",
                        ic.text,
                        ic.border,
                      ]}
                    >
                      {ic.label}
                    </a>
                    <span class="text-slate-400 hidden sm:inline">{ic.desc}</span>
                  </div>
                  <div class="text-right">
                    <span class="font-bold text-white">
                      {count.toLocaleString("en-US")}
                    </span>
                    <span class="text-slate-500 ml-1">({pct}%)</span>
                  </div>
                </div>
                <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden border border-slate-800">
                  <div
                    class:list={["h-full rounded-full", ic.color]}
                    style={`width: ${pct}%`}
                  />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Severity Breakdown & Quick Actions (5 cols) -->
    <div class="lg:col-span-5 flex flex-col gap-6">
      <div class="bg-bg-panel border border-border-grid rounded-xl p-6 space-y-4 flex-1">
        <div class="flex items-center justify-between border-b border-border-grid pb-3">
          <div>
            <h2 class="text-base font-bold text-white">Severidade dos Templates</h2>
            <p class="text-xs text-slate-400 font-mono mt-0.5">
              Mapeamento de criticidade CVE / CWE / Advisory
            </p>
          </div>
          <span class="text-xs font-mono text-slate-400">
            Total: {totalTemplates.toLocaleString("en-US")}
          </span>
        </div>

        <div class="space-y-3">
          {
            severities.map((sev) => {
              const count = templateStats.by_severity?.[sev.key] ?? 0;
              const pct =
                totalTemplates > 0
                  ? Math.min(100, Math.max(1, Math.round((count / totalTemplates) * 100)))
                  : 0;
              return (
                <a
                  href={`/templates?severity=${sev.key}`}
                  class="block p-2.5 rounded-lg bg-slate-900/70 border border-slate-800/80 hover:border-slate-700 transition"
                >
                  <div class="flex items-center justify-between text-xs font-mono mb-1.5">
                    <span class:list={["uppercase font-bold", sev.text]}>
                      {sev.label}
                    </span>
                    <span class="text-slate-200 font-semibold">
                      {count.toLocaleString("en-US")}{" "}
                      <span class="text-slate-500">({pct}%)</span>
                    </span>
                  </div>
                  <div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden">
                    <div
                      class:list={["h-full rounded-full", sev.colorBar || sev.color]}
                      style={`width: ${pct}%`}
                    />
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Quick-Links & Architectural Guardrails -->
  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <a
      href="/programs"
      class="bg-bg-panel border border-border-grid hover:border-accent-emerald/60 rounded-xl p-4 transition group"
    >
      <div class="text-xs font-mono text-accent-emerald uppercase">01 • Governança</div>
      <div class="text-sm font-bold text-white mt-1 group-hover:text-accent-emerald">
        Programas & Testador Ao Vivo →
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Simule URLs, portas e IPs contra a matriz de precedência de 7 camadas.
      </p>
    </a>

    <a
      href="/assets"
      class="bg-bg-panel border border-border-grid hover:border-accent-cyan/60 rounded-xl p-4 transition group"
    >
      <div class="text-xs font-mono text-accent-cyan uppercase">02 • Superfície</div>
      <div class="text-sm font-bold text-white mt-1 group-hover:text-accent-cyan">
        Grafo Topológico de Ativos →
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Visualize relacionamentos entre domínios em escopo e IPs de observação.
      </p>
    </a>

    <a
      href="/scans"
      class="bg-bg-panel border border-border-grid hover:border-accent-amber/60 rounded-xl p-4 transition group"
    >
      <div class="text-xs font-mono text-accent-amber uppercase">03 • Automação</div>
      <div class="text-sm font-bold text-white mt-1 group-hover:text-accent-amber">
        Detection Planner & Poda CDN →
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Execute recon e varreduras com poda automática de templates atrás de WAF/CDN.
      </p>
    </a>

    <a
      href="/telemetry"
      class="bg-bg-panel border border-border-grid hover:border-accent-crimson/60 rounded-xl p-4 transition group"
    >
      <div class="text-xs font-mono text-accent-crimson uppercase">04 • Egress Proxy</div>
      <div class="text-sm font-bold text-white mt-1 group-hover:text-accent-crimson">
        Telemetria & Redação em Tempo Real →
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Inspecione token-bucket 0.5 req/s, bloqueio SSRF e sanitização S3.
      </p>
    </a>
  </section>

  <!-- Recent Audit Events Table -->
  <section class="bg-bg-panel border border-border-grid rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-border-grid flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-white">
          Trilha de Auditoria Imutável (AuditEvents Append-Only)
        </h2>
        <p class="text-xs text-slate-400 font-mono mt-0.5">
          Triggers PostgreSQL bloqueiam UPDATE e DELETE na tabela audit_events
        </p>
      </div>
      <span class="text-xs font-mono px-2.5 py-1 rounded bg-slate-900 border border-slate-700 text-slate-300">
        APPEND-ONLY ENFORCED
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs font-mono">
        <thead>
          <tr class="border-b border-border-grid bg-slate-950/60 text-slate-400 uppercase">
            <th class="py-3 px-4">Seq</th>
            <th class="py-3 px-4">Timestamp</th>
            <th class="py-3 px-4">Actor</th>
            <th class="py-3 px-4">Event Type</th>
            <th class="py-3 px-4">Target Object</th>
            <th class="py-3 px-4">Payload Summary</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-grid">
          {
            auditEvents.map((ev) => (
              <tr class="hover:bg-slate-800/30 transition">
                <td class="py-3 px-4 text-accent-emerald font-bold">#{ev.sequence}</td>
                <td class="py-3 px-4 text-slate-400">{ev.occurred_at}</td>
                <td class="py-3 px-4 text-cyan-300">{ev.actor}</td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-slate-200">
                    {ev.event_type}
                  </span>
                </td>
                <td class="py-3 px-4 text-slate-300">
                  {ev.object_type}:{ev.object_id}
                </td>
                <td class="py-3 px-4 text-slate-400 max-w-md truncate">
                  {JSON.stringify(ev.payload)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
