---
import BaseLayout from "../layouts/BaseLayout.astro";
import SparklineSVG from "../components/SparklineSVG";
import {
  fetchHealth,
  fetchPrograms,
  fetchTemplateStats,
  fetchFindings,
  fetchTelemetrySummary,
} from "../lib/api";

const [health, programs, templateStats, findings, telemetry] = await Promise.all([
  fetchHealth(),
  fetchPrograms(),
  fetchTemplateStats(),
  fetchFindings(),
  fetchTelemetrySummary(),
]);

const activeProgramsCount = programs.filter((p) => p.state === "active").length;
const totalScopedAssets = programs.reduce((acc, p) => acc + (p.assets_count || 0), 0);

const totalTemplates = templateStats.total ?? health.template_count ?? 0;
const safeTemplates = templateStats.by_impact_class?.safe_read_only ?? 0;
const safeRatioPct = totalTemplates > 0 ? Math.min(100, Math.round((safeTemplates / totalTemplates) * 100)) : 0;

const validatedE2Count = findings.filter(
  (f) =>
    f.status === "validated" ||
    f.evidence_level === "E2" ||
    f.evidence_level === "E3"
).length;

const impactClasses = [
  { key: "safe_read_only", label: "safe_read_only", mode: "SAFE", method: "GET/HEAD", color: "text-[#34d399]", bar: "bg-[#34d399]" },
  { key: "active_reviewed", label: "active_reviewed", mode: "REVIEWED", method: "GET/POST", color: "text-[#22d3ee]", bar: "bg-[#22d3ee]" },
  { key: "stateful", label: "stateful", mode: "MUTATING", method: "POST/PUT", color: "text-[#fbbf24]", bar: "bg-[#fbbf24]" },
  { key: "intrusive", label: "intrusive", mode: "RESTRICTED", method: "FUZZ/BRUTE", color: "text-[#f87171]", bar: "bg-[#f87171]" },
  { key: "lab_only", label: "lab_only", mode: "SANDBOX", method: "HEADLESS/CODE", color: "text-[#a78bfa]", bar: "bg-[#a78bfa]" },
];

const auditEvents = health.recent_audit_events?.length
  ? health.recent_audit_events
  : [];
---

<BaseLayout
  title="Visão Geral"
  activeNav="overview"
>
  {
    programs.length === 0 && (
      <section class="card card-pad flex flex-wrap items-center justify-between gap-3 border-amber-500/30 bg-amber-950/10">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-amber-400"></div>
          <div>
            <div class="text-xs font-semibold text-white">Nenhum programa cadastrado</div>
            <div class="text-[11px] text-[#8b98a9]">Cadastre seu primeiro programa para definir regras de escopo e mapear a superfície de ataque.</div>
          </div>
        </div>
        <a href="/programs" class="btn btn-primary text-xs">+ Cadastrar Programa</a>
      </section>
    )
  }

  <!-- 6x2 Telemetry & KPI Grid with SVG Sparklines & Capacity Bars -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3.5">
    <!-- Card 1: Egress Throughput -->
    <div class="card card-pad flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between">
        <span class="card-title">EGRESS RPS</span>
      </div>
      <div>
        <div class="kpi">{telemetry.rate_limit_rps.toFixed(2)} <span class="text-xs font-normal text-[#8b98a9]">req/s</span></div>
        <div class="text-[11px] num text-[#738196] mt-0.5">
          burst {telemetry.burst_capacity} · conc {telemetry.concurrency_limit}
        </div>
      </div>
      <SparklineSVG data={telemetry.rps_series} color="emerald" height={32} min={0} max={0.65} />
    </div>

    <!-- Card 2: Scope Evaluations -->
    <div class="card card-pad flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between">
        <span class="card-title">PROGRAMAS</span>
        <a href="/programs" class="font-mono text-[10px] text-[#22d3ee] hover:underline">ESCOPO →</a>
      </div>
      <div>
        <div class="kpi">{activeProgramsCount} <span class="text-xs font-normal text-[#8b98a9]">ativos</span></div>
        <div class="text-[11px] num text-[#738196] mt-0.5">
          {totalScopedAssets} ativos mapeados
        </div>
      </div>
      <SparklineSVG data={telemetry.scope_evals_series} color="cyan" height={32} />
    </div>

    <!-- Card 3: Anti-SSRF Guard -->
    <div class="card card-pad flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between">
        <span class="card-title">SSRF BLOCKS</span>
      </div>
      <div>
        <div class="kpi">{telemetry.ssrf_blocks_series?.reduce((a, b) => a + b, 0) ?? 0} <span class="text-xs font-normal text-[#8b98a9]">bloqueios</span></div>
        <div class="text-[11px] num text-[#738196] mt-0.5">
          Regras de rede & IP
        </div>
      </div>
      <SparklineSVG data={telemetry.ssrf_blocks_series} color="amber" height={32} min={0} max={3} />
    </div>

    <!-- Card 4: DetectionPlanner Latency -->
    <div class="card card-pad flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between">
        <span class="card-title">PLANNER TIME</span>
        <a href="/scans" class="font-mono text-[10px] text-[#34d399] hover:underline">RUNNER →</a>
      </div>
      <div>
        <div class="kpi">{telemetry.planner_latency_ms} <span class="text-xs font-normal text-[#8b98a9]">ms</span></div>
        <div class="text-[11px] num text-[#738196] mt-0.5">
          latência de planejamento
        </div>
      </div>
      <SparklineSVG data={telemetry.planner_ms_series} color="emerald" height={32} min={5} max={15} />
    </div>

    <!-- Card 5: AST Template Catalog Capacity -->
    <div class="card card-pad flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between">
        <span class="card-title">TEMPLATES</span>
        <a href="/templates" class="font-mono text-[10px] text-[#22d3ee] hover:underline">CATÁLOGO →</a>
      </div>
      <div>
        <div class="kpi">{totalTemplates.toLocaleString("en-US")}</div>
        <div class="text-[11px] num text-[#738196] mt-0.5">
          {safeTemplates.toLocaleString("en-US")} safe ({safeRatioPct}%)
        </div>
      </div>
      <div class="space-y-1 pt-1">
        <div class="bar text-[#22d3ee]">
          <span style={`width: ${safeRatioPct}%`}></span>
        </div>
        <div class="flex justify-between text-[10px] num text-[#738196]">
          <span>leitura segura</span>
          <span>{safeRatioPct}%</span>
        </div>
      </div>
    </div>

    <!-- Card 6: Validated E2 Forensic Findings -->
    <div class="card card-pad flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between">
        <span class="card-title">ACHADOS E2</span>
        <a href="/findings" class="font-mono text-[10px] text-[#a78bfa] hover:underline">TRIAGEM →</a>
      </div>
      <div>
        <div class="kpi">{validatedE2Count} <span class="text-xs font-normal text-[#8b98a9]">validados</span></div>
        <div class="text-[11px] num text-[#738196] mt-0.5">
          {findings.length} no total
        </div>
      </div>
      <SparklineSVG data={telemetry.db_latency_ms_series} color="purple" height={32} />
    </div>
  </section>

  <!-- Split Middle Row: SESSION BENCHMARKS (Catalog Matrix) + CONVERSATION CACHE / ENGINE -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <!-- Left 7 Cols: Impact Class & Severity Benchmark Table -->
    <div class="lg:col-span-7 card overflow-hidden">
      <div class="px-4 py-3 border-b border-[#1b2230] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="card-title">MATRIZ DE IMPACTO · TEMPLATES</span>
          <details class="hint">
            <summary>?</summary>
            <div>
              Classificador estático de impacto. Templates com métodos mutáveis, payloads intrusivos ou protocolos fora da whitelist são categorizados.
            </div>
          </details>
        </div>
        <a href="/templates?impact_class=safe_read_only" class="text-[11px] font-mono text-[#34d399] hover:underline">
          filtrar safe_read_only →
        </a>
      </div>

      <table class="dtable num">
        <thead>
          <tr>
            <th>Impact Class</th>
            <th>Policy Gate</th>
            <th>Methods</th>
            <th class="r">Templates</th>
            <th class="r">Share</th>
            <th class="w-28">Capacity</th>
          </tr>
        </thead>
        <tbody>
          {
            impactClasses.map((ic) => {
              const count = templateStats.by_impact_class?.[ic.key] ?? 0;
              const pct = totalTemplates > 0 ? Math.round((count / totalTemplates) * 1000) / 10 : 0;
              return (
                <tr>
                  <td>
                    <a href={`/templates?impact_class=${ic.key}`} class:list={["font-semibold hover:underline", ic.color]}>
                      {ic.label}
                    </a>
                  </td>
                  <td class="text-[#8b98a9]">{ic.mode}</td>
                  <td class="text-[#738196]">{ic.method}</td>
                  <td class="r font-semibold text-white">{count.toLocaleString("en-US")}</td>
                  <td class="r text-[#8b98a9]">{pct.toFixed(1)}%</td>
                  <td>
                    <div class="bar text-[#34d399]">
                      <span class={ic.bar} style={`width: ${Math.max(2, Math.min(100, pct))}%`} />
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <!-- Right 5 Cols: ENGINE / CONTROL PLANE POSTURE -->
    <div class="lg:col-span-5 card overflow-hidden flex flex-col justify-between">
      <div class="px-4 py-3 border-b border-[#1b2230] flex items-center justify-between">
        <span class="card-title">TELEMETRIA DE SERVIÇOS</span>
      </div>

      <div class="p-4 grid grid-cols-2 gap-3 num text-xs">
        <div class="p-2.5 rounded-lg bg-[#11161f] border border-[#1b2230]">
          <div class="text-[10px] text-[#738196] uppercase">Banco de Dados (PostgreSQL)</div>
          <div class="text-base font-semibold text-white mt-0.5">{telemetry.db_latency_ms} ms</div>
          <div class="text-[10px] text-[#34d399] mt-0.5">{health.db_connected ? "Conectado" : "Offline"}</div>
        </div>

        <div class="p-2.5 rounded-lg bg-[#11161f] border border-[#1b2230]">
          <div class="text-[10px] text-[#738196] uppercase">Cache & Rate-Limit (Valkey)</div>
          <div class="text-base font-semibold text-[#22d3ee] mt-0.5">{telemetry.valkey_latency_ms} ms</div>
          <div class="text-[10px] text-[#8b98a9] mt-0.5">{telemetry.rate_limit_rps > 0 ? `${telemetry.rate_limit_rps} req/s` : "Em repouso"}</div>
        </div>
      </div>

      <!-- Severity Mini Bar Strip -->
      <div class="px-4 py-3 border-t border-[#1b2230] bg-[#070a0f]/40 flex items-center justify-between text-[11px] num">
        <span class="text-[#738196]">SEVERITY SPLIT</span>
        <div class="flex items-center gap-3">
          <a href="/templates?severity=critical" class="text-[#f87171] hover:underline">
            C:{templateStats.by_severity?.critical ?? 0}
          </a>
          <a href="/templates?severity=high" class="text-orange-400 hover:underline">
            H:{templateStats.by_severity?.high ?? 0}
          </a>
          <a href="/templates?severity=medium" class="text-[#fbbf24] hover:underline">
            M:{templateStats.by_severity?.medium ?? 0}
          </a>
          <a href="/templates?severity=low" class="text-[#22d3ee] hover:underline">
            L:{templateStats.by_severity?.low ?? 0}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Audit Events Section -->
  <section class="card overflow-hidden">
    <div class="px-4 py-3 border-b border-[#1b2230] flex items-center justify-between">
      <span class="card-title">EVENTOS RECENTES</span>
      <span class="pill text-[#34d399]">AUDITORIA</span>
    </div>

    {
      auditEvents.length === 0 ? (
        <div class="p-8 text-center text-xs text-[#738196] font-mono">
          Nenhum evento recente
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="dtable num">
            <thead>
              <tr>
                <th>Seq</th>
                <th>Data / Hora</th>
                <th>Ator</th>
                <th>Evento</th>
                <th>Objeto</th>
                <th>Payload</th>
              </tr>
            </thead>
            <tbody>
              {
                auditEvents.map((ev) => (
                  <tr>
                    <td class="text-[#34d399] font-semibold">#{ev.sequence}</td>
                    <td class="text-[#738196]">{ev.occurred_at}</td>
                    <td class="text-[#22d3ee]">{ev.actor}</td>
                    <td>
                      <span class="pill text-white">{ev.event_type}</span>
                    </td>
                    <td class="text-[#e6edf3]">
                      {ev.object_type}:{ev.object_id}
                    </td>
                    <td class="text-[#8b98a9] max-w-md truncate">
                      {JSON.stringify(ev.payload)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</BaseLayout>
