# ==============================================================================
# PenteFino Platform Environment Configuration Template
# Copy this file to .env before starting services or running local applications:
#   cp .env.example .env
# ==============================================================================

# Compose Project Settings
COMPOSE_PROJECT_NAME=pentefino
BIND_IP=127.0.0.1

# ------------------------------------------------------------------------------
# 1. PostgreSQL Relational Persistence (SQLAlchemy 2.0 Async / Alembic)
# ------------------------------------------------------------------------------
POSTGRES_DB=pentefino
POSTGRES_USER=pentefino
POSTGRES_PASSWORD=pentefino_secure_pass
POSTGRES_PORT=5432

# Database Connection URLs (Host / Local Development)
DATABASE_URL=postgresql+asyncpg://pentefino:pentefino_secure_pass@localhost:5432/pentefino
DATABASE_SYNC_URL=postgresql+psycopg2://pentefino:pentefino_secure_pass@localhost:5432/pentefino

# Database Connection URL (Docker Inter-Container Network)
DATABASE_INTERNAL_URL=postgresql+asyncpg://pentefino:pentefino_secure_pass@postgres:5432/pentefino

# ------------------------------------------------------------------------------
# 2. Valkey High-Frequency In-Memory Cache & Token Bucket (BSD-3-Clause)
# ------------------------------------------------------------------------------
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379/0
VALKEY_INTERNAL_URL=redis://valkey:6379/0

# Rate Limiter Policy Defaults (ADR-02 / Survey R3)
RATE_LIMIT_HOST_RPS=0.5
RATE_LIMIT_PROGRAM_RPS=2.0
RATE_LIMIT_MAX_CONCURRENCY_PER_HOST=1

# ------------------------------------------------------------------------------
# 3. SeaweedFS Local S3-Compatible Evidence Storage (Apache-2.0)
# ------------------------------------------------------------------------------
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888

# S3 Endpoints
S3_ENDPOINT_URL=http://localhost:8333
S3_INTERNAL_URL=http://seaweedfs:8333
S3_INTERNAL_ENDPOINT_URL=http://seaweedfs:8333

# S3 IAM Credentials (aligned with docker/seaweedfs/s3.json)
S3_ACCESS_KEY_ID=pentefino_s3_admin
S3_SECRET_ACCESS_KEY=pentefino_s3_secret
S3_ACCESS_KEY=pentefino_s3_admin
S3_SECRET_KEY=pentefino_s3_secret
S3_BUCKET=evidence
S3_BUCKET_NAME=evidence
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 4. RabbitMQ AMQP Message Broker & Celery Task Queue
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=pentefino
RABBITMQ_DEFAULT_PASS=pentefino_rabbit_pass
RABBITMQ_DEFAULT_VHOST=/pentefino
RABBITMQ_USER=pentefino
RABBITMQ_PASSWORD=pentefino_rabbit_pass
RABBITMQ_VHOST=/pentefino
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Celery Broker URLs (URL-encoded vhost /pentefino as %2Fpentefino)
CELERY_BROKER_URL=amqp://pentefino:pentefino_rabbit_pass@localhost:5672/%2Fpentefino
CELERY_BROKER_INTERNAL_URL=amqp://pentefino:pentefino_rabbit_pass@rabbitmq:5672/%2Fpentefino
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 5. Forward Egress Proxy & Traffic Controller (apps/proxy)
# ------------------------------------------------------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_CA_CERT_PATH=./docker/certs/ca.crt
PROXY_CA_KEY_PATH=./docker/certs/ca.key
PROXY_REDACTION_PROFILE=bounty-safe-v1
